# === Qdrant ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_operational
QDRANT_SCHEMA_COLLECTION=rag_schema_meta

# === Ollama ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_ROUTER=qwen3:4b

# === Cloud LLM (routed through OpenRouter, OpenAI-compatible) ===
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Reasoning-grade but cheap: SQL generation and final answers.
CLOUD_MODEL=openai/gpt-oss-120b
# High-volume, low-stakes: contextual prefixes and the faithfulness gate.
CONTEXT_MODEL=mistralai/mistral-nemo
# RAGAS judge — raise this before trusting published eval numbers.
JUDGE_MODEL=openai/gpt-oss-120b
ROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# === Embeddings ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_FALLBACK=BAAI/bge-small-en-v1.5

# === Chunking ===
CHUNK_SIZE=512
CHUNK_OVERLAP=64 

# === Retrieval ===
RETRIEVAL_TOP_K=50
RERANK_TOP_N=7
RERANK_SCORE_THRESHOLD=0.3
MAX_RETRIEVAL_ITERATIONS=5
TOKEN_BUDGET_PER_QUERY=4000

# === Database ===
DB_URL=sqlite+aiosqlite:///./operational.db

# === Semantic Cache (leave empty to disable) ===
SEMANTIC_CACHE_URL=

# === Langfuse Observability (leave empty to disable) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# === Prometheus ===
PROMETHEUS_PORT=8001

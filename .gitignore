# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# Env / secrets
.env
*.env.local

# DB files
*.db
*.db-shm

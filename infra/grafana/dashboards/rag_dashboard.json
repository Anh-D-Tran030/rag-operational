{
  "title": "Operational RAG Pipeline",
  "uid": "rag-pipeline-dashboard",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["rag", "operational"],
  "__inputs": [],
  "__requires": [],
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Cache Hit vs Miss Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(rag_cache_hit_total{result=\"hit\"}[5m])",
          "legendFormat": "cache hits/s",
          "refId": "A"
        },
        {
          "expr": "rate(rag_cache_hit_total{result=\"miss\"}[5m])",
          "legendFormat": "cache misses/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Query Routing Decisions",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(rag_route_decision{route=\"vector_search\"}[5m])",
          "legendFormat": "vector_search",
          "refId": "A"
        },
        {
          "expr": "rate(rag_route_decision{route=\"text_to_sql\"}[5m])",
          "legendFormat": "text_to_sql",
          "refId": "B"
        },
        {
          "expr": "rate(rag_route_decision{route=\"hybrid\"}[5m])",
          "legendFormat": "hybrid",
          "refId": "C"
        },
        {
          "expr": "rate(rag_route_decision{route=\"local\"}[5m])",
          "legendFormat": "local",
          "refId": "D"
        },
        {
          "expr": "rate(rag_route_decision{route=\"cloud\"}[5m])",
          "legendFormat": "cloud",
          "refId": "E"
        }
      ]
    },
    {
      "id": 3,
      "title": "Retrieval Confidence Distribution",
      "type": "histogram",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(rag_retrieval_confidence_bucket[5m])",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Reranker Max Score Distribution",
      "type": "histogram",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(rag_reranker_score_max_bucket[5m])",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Chunks Per Query",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(rag_chunks_per_query_sum[5m]) / rate(rag_chunks_per_query_count[5m])",
          "legendFormat": "avg chunks/query",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Estimated Query Cost (USD)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(rag_query_cost_usd_sum[5m])",
          "legendFormat": "cost USD/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Latency by Pipeline Component (p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(rag_latency_by_component_bucket{component=\"route\"}[5m]))",
          "legendFormat": "route p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(rag_latency_by_component_bucket{component=\"retrieval\"}[5m]))",
          "legendFormat": "retrieval p99",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(rag_latency_by_component_bucket{component=\"sql\"}[5m]))",
          "legendFormat": "sql p99",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, rate(rag_latency_by_component_bucket{component=\"generation\"}[5m]))",
          "legendFormat": "generation p99",
          "refId": "D"
        }
      ]
    }
  ]
}

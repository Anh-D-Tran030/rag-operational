{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
      "secrets/**": "deny",
      "*.db": "deny",
      "qdrant_storage/**": "deny"
    },
    "edit": {
      ".env": "deny",
      ".env.*": "deny",
      "secrets/**": "deny",
      "*.db": "deny",
      "qdrant_storage/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git branch -D*": "deny",
      "git rebase*": "deny",
      "git commit --amend*": "deny",
      "git filter-branch*": "deny"
    }
  },
  "provider": {
    "anthropic": {
      "type": "api",
      "models": {
        "claude-sonnet-4.6": {}
      }
    },
    "openai": {
      "type": "api"
    },
    "deepseek": {
      "options": { "apiKey": "{env:DEEPSEEK_API_KEY}" }
    },
      "ollama": {
        "npm": "@ai-sdk/openai-compatible",
        "options": { "baseURL": "http://localhost:11434/v1" },
        "models": {
        "qwen2.5:7b": { "tools": true }
        }
      }
  },
  "agent": {
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.0,
      "steps": 10,
      "permission": {
        "edit": { "**": "deny", ".agent-context/runs/**/plan.md": "allow" },
        "bash": "deny"
      },
      "description": "Read-only plan authoring. Writes the active run plan.md then locks it."
    },
    "build": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.2,
      "steps": 25,
      "permission": {
        "edit": "allow",
        "bash": {
          "*":           "ask",
          "pytest*":     "allow",
          "docker*":     "allow",
          "git diff*":   "allow",
          "git add*":    "allow",
          "git commit*": "allow",
          "pip*":        "ask",
          "git push*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "git branch -D*": "deny",
          "git rebase*": "deny",
          "git commit --amend*": "deny",
          "git filter-branch*": "deny"
        }
      },
      "description": "Reads the active run plan.md and explore.md. Implements only files listed in the locked plan. Reads run test.md for compressed failures."
    },
    "code-reviewer": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": { "**": "deny", ".agent-context/runs/**/review.md": "allow" },
        "bash": { "*": "deny", "git diff*": "allow" }
      },
      "description": "Code quality, logic bugs, syntax checks. Outputs to review.md. SECURITY VIOLATION blocks git commit."
    },
    "tester": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.1,
      "steps": 20,
      "permission": {
        "edit": { "**": "deny", "tests/**": "allow", ".agent-context/runs/**/test.md": "allow" },
        "bash": { "*": "deny", "pytest*": "allow" }
      },
      "description": "Writes and runs pytest tests. Failure output piped to compressor before build reads it."
    },
    "explore": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.0,
      "steps": 15,
      "permission": {
        "edit": { "**": "deny", ".agent-context/runs/**/explore.md": "allow" },
        "bash": {
          "*":     "deny",
          "grep*": "allow",
          "find*": "allow",
          "cat*":  "allow",
          "ls*":   "allow"
        }
      },
      "description": "Read-only grep and schema exploration. Outputs findings to explore.md."
    },
    "compressor": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.0,
      "steps": 5,
      "permission": {
        "edit": { "**": "deny", ".agent-context/runs/**/test.md": "allow", ".agent-context/runs/**/handoff.md": "allow" },
        "bash": "deny"
      },
      "description": "Compresses raw failures into the active run test.md and refreshes concise handoff.md. It is a support role, not a gate."
    },
    "docs-writer": {
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.3,
      "steps": 8,
      "permission": {
        "edit": { "**": "deny", "**/*.md": "allow" },
        "bash": "deny"
      },
      "description": "Updates status.md after each session. Logs blockers and discovered dependencies."
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "type": "api",
      "models": {
        "claude-sonnet-4.6": {}
      }
    },
    "openai": {
      "type": "api"
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3:4b-16k":          { "tools": true },
        "qwen2.5-coder:7b-16k": { "tools": true }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-sonnet-4.6",
      "temperature": 0.0,
      "steps": 10,
      "permission": {
        "edit": { "plan.md": "allow", "**": "deny" },
        "bash": "deny"
      },
      "description": "Read-only plan authoring. Writes plan.md then locks it."
    },
    "build": {
      "model": "openai/gpt-5.5-codex",
      "temperature": 0.2,
      "steps": 25,
      "permission": {
        "edit": "allow",
        "bash": {
          "pytest*":     "allow",
          "docker*":     "allow",
          "git diff*":   "allow",
          "git add*":    "allow",
          "git commit*": "allow",
          "pip*":        "ask",
          "*":           "ask"
        }
      },
      "description": "Reads plan.md and explore.md. Implements only files listed in plan.md. Reads trace.md for errors — never raw logs."
    },
    "code-reviewer": {
      "model": "ollama/qwen2.5-coder:7b-16k",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": { "review.md": "allow", "**": "deny" },
        "bash": { "git diff*": "allow", "*": "deny" }
      },
      "description": "Code quality, logic bugs, syntax checks. Outputs to review.md. SECURITY VIOLATION blocks git commit."
    },
    "tester": {
      "model": "ollama/qwen2.5-coder:7b-16k",
      "temperature": 0.1,
      "steps": 20,
      "permission": {
        "edit": { "tests/**": "allow", "**": "deny" },
        "bash": { "pytest*": "allow", "*": "deny" }
      },
      "description": "Writes and runs pytest tests. Failure output piped to compressor before build reads it."
    },
    "explore": {
      "model": "ollama/qwen3:4b-16k",
      "temperature": 0.0,
      "steps": 15,
      "permission": {
        "edit": { "explore.md": "allow", "**": "deny" },
        "bash": {
          "grep*": "allow",
          "find*": "allow",
          "cat*":  "allow",
          "ls*":   "allow",
          "*":     "deny"
        }
      },
      "description": "Read-only grep and schema exploration. Outputs findings to explore.md."
    },
    "compressor": {
      "model": "ollama/qwen3:4b-16k",
      "temperature": 0.0,
      "steps": 5,
      "permission": {
        "edit": { "trace.md": "allow", "**": "deny" },
        "bash": "deny"
      },
      "description": "Compresses raw error output into trace.md. Always called before Build reads any error output."
    },
    "docs-writer": {
      "model": "ollama/qwen3:4b-16k",
      "temperature": 0.3,
      "steps": 8,
      "permission": {
        "edit": { "**/*.md": "allow", "**": "deny" },
        "bash": "deny"
      },
      "description": "Updates status.md after each session. Logs blockers and discovered dependencies."
    }
  }
}
